# Nusxa: frontend/.env deb saqlang (gitda yo'q). Build/restartdan keyin ishlaydi.
#
# Mahalliy backend (runserver):
#   VITE_API_BASE=http://127.0.0.1:8000/api
#
# Vercel + api/[...path].ts proksi (tavsiya):
#   VITE_API_BASE=/api
#
# To'g'ridan-to'g'ri Render API:
#   VITE_API_BASE=https://SIZNING-API.onrender.com/api
#
VITE_API_BASE=http://127.0.0.1:8000/api
