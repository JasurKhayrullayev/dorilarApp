# Nusxa: frontend/.env deb saqlang. Vite faqat VITE_* ni buildga kiritadi.
#
# --- Tavsiya etilgan: to'liq API path (axios barcha so'rovlarga shu baseURL qo'shadi) ---
# Render (Django /api/ ostida):
VITE_API_BASE=https://dorilarapp.onrender.com/api
#
# Mahalliy backend:
# VITE_API_BASE=http://127.0.0.1:8000/api
#
# Vercel + api/[...path].ts proksi (BACKEND_ORIGIN Vercelda alohida):
# VITE_API_BASE=/api
#
# --- Yoki faqat domen (VITE_API_BASE bo'sh bo'lsa, avtomatik .../api) ---
# VITE_API_URL=https://dorilarapp.onrender.com
