# Vite faqat VITE_* ni client bundle ga kiritadi.
#
# === Mahalliy (vite dev) — .env yoki .env.local ===
# VITE_API_URL shu fayllarda BO'LMASIN yoki faqat localhost:
#   VITE_API_URL=http://127.0.0.1:8000
# Oddiy usul (tavsiya):
VITE_API_BASE=http://127.0.0.1:8000/api
#
# === Production build (vite build / Vercel) ===
# frontend/.env.production — repoda bor (Render domeni).
# Vercel Dashboardda ham xuddi shu: VITE_API_URL=https://dorilarapp.onrender.com
# (Dashboard qiymati build vaqtida .env.production ustidan ustun bo'lishi mumkin.)
#
# --- To'liq path (VITE_API_URL dan ustun) ---
# VITE_API_BASE=https://dorilarapp.onrender.com/api
# VITE_BACKEND_URL=https://dorilarapp.onrender.com/api
#
# --- Faqat domen (/api qo'shiladi) ---
# VITE_API_URL=https://dorilarapp.onrender.com
# VITE_BACKEND_ORIGIN=https://dorilarapp.onrender.com
#
# Vercel proksi (brauzerda /api):
# VITE_API_BASE=/api
# + Vercel server env: BACKEND_ORIGIN=https://dorilarapp.onrender.com
