# =============================================================================
# Nusxa oling:  backend/.env  yarating va shu faylni nusxalab to'ldiring.
# Haqiqiy maxfiy qiymatlar faqat .env da; .env ni gitga commit qilmang.
# =============================================================================

# --- Django ---
# Maxfiy kalit (productionda majburiy). Yaratish:
#   PowerShell:  [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#   yoki OpenSSL: openssl rand -hex 32
DJANGO_SECRET_KEY=bu-yerni-o-zingizning-uzun-tasodifiy-kalitingiz-bilan-almashtiring

# 1 = rivojlantirish (batafsil xatolar), 0 = production
DJANGO_DEBUG=1

# Faqat DOMEN (https:// YO'Q — bu CORS_ORIGINS uchun):
#   dorilarapp.onrender.com,localhost,127.0.0.1
# NOTO'G'RI: https://dorilar-app.vercel.app  (400 DisallowedHost beradi)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dorilarapp.onrender.com,backend,web

# Eslatma: docker-compose db va backend servislari ./backend/.env dan o'qiydi.
# Compose ichida POSTGRES_HOST=db avtomatik beriladi (localhost emas).

# --- Ma'lumotlar bazasi ---
# 1 / true — SQLite (backend/db.sqlite3)
# 0 / false — Postgres (DATABASE_URL yoki POSTGRES_*)
# Qatorni butunlay o'chirib tashlasangiz: DJANGO_DEBUG=1 va DATABASE_URL bo'sh bo'lsa → avtomatik SQLite
USE_SQLITE=1

# Neon / Render tashqi Postgres — to'liq ulanish qatori (tavsiya etiladi).
# Olish: https://neon.tech → loyiha → Connection string (postgresql://...)
# Render: o'z Postgres yoki Neon ulanmasini Environment ga qo'shasiz.
DATABASE_URL=

# Agar DATABASE_URL bo'sh va USE_SQLITE=0 bo'lsa — alohida maydonlar ishlatiladi.
# docker-compose.yml dagi db bilan moslashtiring (default bad_crm).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bad_crm
POSTGRES_USER=bad_crm
POSTGRES_PASSWORD=bad_crm

# --- CORS (frontend domenlari) ---
# Vergul bilan. Production Vercel domeningizni qo'shing, masalan:
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dorilar-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vercel preview URL lar (har branch uchun alohida domen) — CORS_ORIGINS ga hammasini yozish o'rniga:
# CORS_VERCEL_APP_REGEX=1

# --- Ixtiyoriy: Redis (sessiya/kesh) ---
# Docker compose: redis://redis:6379/0
# Bo'sh qoldirilsa — lokal LocMem cache ishlatiladi (settings.py).
REDIS_URL=
